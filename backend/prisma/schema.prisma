generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id        String    @id @default(uuid())
  nameEn    String    @map("name_en")
  nameHi    String    @map("name_hi")
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("categories")
}

model Product {
  id           String         @id @default(uuid())
  barcode      String?        @unique
  nameEn       String         @map("name_en")
  nameHi       String?        @map("name_hi")
  categoryId   String         @map("category_id")
  category     Category       @relation(fields: [categoryId], references: [id])
  minAlertQty  Int            @default(0) @map("min_alert_qty")
  batches      ProductBatch[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([barcode])
  @@index([nameEn])
  @@index([nameHi])
  @@index([categoryId])
  @@map("products")
}

model ProductBatch {
  id           String    @id @default(uuid())
  productId    String    @map("product_id")
  product      Product   @relation(fields: [productId], references: [id])
  purchaseCost Decimal   @db.Decimal(10, 2) @map("purchase_cost")
  sellingPrice Decimal   @db.Decimal(10, 2) @map("selling_price")
  initialStock Int       @map("initial_stock")
  currentStock Int       @map("current_stock")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([productId])
  @@index([createdAt])
  @@map("product_batches")
}

model Customer {
  id            String         @id @default(uuid())
  phone         String         @unique
  name          String?
  firstName     String?        @map("first_name")
  totalOrders   Int            @default(0) @map("total_orders")
  lifetimeSpend Decimal        @default(0) @db.Decimal(10, 2) @map("lifetime_spend")
  lastPurchase  DateTime?      @map("last_purchase")
  tags          String[]       @default([])
  lastCategory  String?        @map("last_category")
  invoices      SalesInvoice[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([phone])
  @@map("customers")
}

model SalesInvoice {
  id            String        @id @default(uuid())
  invoiceNo     String        @unique @map("invoice_no")
  customerId    String?       @map("customer_id")
  customer      Customer?     @relation(fields: [customerId], references: [id])
  customerPhone String?       @map("customer_phone")
  customerName  String?       @map("customer_name")
  totalAmount   Decimal       @db.Decimal(10, 2) @map("total_amount")
  totalProfit   Decimal       @db.Decimal(10, 2) @map("total_profit")
  paymentMode   String        @map("payment_mode") // CASH, UPI, CARD, KHATA
  waStatus      String        @default("PENDING") @map("wa_status") // PENDING, QUEUED, SENT, FAILED
  items         InvoiceItem[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([invoiceNo])
  @@index([customerPhone])
  @@map("sales_invoices")
}

model InvoiceItem {
  id            String       @id @default(uuid())
  invoiceId     String       @map("invoice_id")
  invoice       SalesInvoice @relation(fields: [invoiceId], references: [id])
  productId     String       @map("product_id")
  productName   String       @map("product_name")
  batchId       String       @map("batch_id")
  quantity      Int
  unitCost      Decimal      @db.Decimal(10, 2) @map("unit_cost")
  unitSalePrice Decimal      @db.Decimal(10, 2) @map("unit_sale_price")
  lineProfit    Decimal      @db.Decimal(10, 2) @map("line_profit")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([invoiceId])
  @@map("invoice_items")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("CASHIER") // ADMIN, CASHIER
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
